#what		: Searched Command ka pakage name pta krna ho, single 'what' command installed,not installed, both inn prr based saarey pakages show kr dega
#whatisp 	: whatis command for pakage
#whatiss 	: Full description of pakage or command
#spallbin 	: show binary executables and it's description of given pakages
#scc		: (search command's command) given command kis pakage ka hai uska name aur uski binary executatables show kro
#yn	 	: (yes no) given pakage hai ki nhi

#d 		: (Dependency) Show dependency of given pakage
#dr		: (Dependency_Reverse) kon kon se pakage, given pakage/dependency pr nirbhar hai 

#s		: Match package names containing the given word
#S		: Match package names starting with the given word

#deballbin	: show ".deb" file all binary		(i) apt download <pkg_name>

#whichp 	: given file name are part of which pakage
#all 		: show all files, manuals and executables of that pakage
#whichponly	: (which pakage only) List the NAMES of all packages that contain a file matching the given filename
#whichpall	: (which pakage&path all) List the NAMES and PATHS of all packages containing a file that matches the given filename

#what
what() {
    local G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' N=$'\e[0m' n l pk c col lab alt t=() m=("$@") cmd
    local -A d

    if (($# == 0)); then   # ---- menu mode ----
        read -rp $'1. Installed only\n2. Not installed only\n3. Both\nChoice [1-3]: ' c
        [[ $c == [123] ]] || { echo "Invalid choice"; return 1; }
        if [[ $c != 1 ]] && ! command -v apt-file >/dev/null; then
            echo "Run: sudo apt install apt-file && sudo apt-file update"
            [[ $c == 2 ]] && return 1; c=1
        fi
        printf '%-30s %-35s %s\n' COMMAND PACKAGE SOURCE
        [[ $c != 2 ]] && grep -HE '^/(usr/)?s?bin/[^/]+$' /var/lib/dpkg/info/*.list 2>/dev/null |
            awk -F'\\.list:' -v C="$G" -v N="$N" '
                {sub(".*/","",$1); sub(/:.*/,"",$1); sub(".*/","",$2)}
                !s[$2]++ {printf "%-30s %-35s %sinstalled%s\n",$2,$1,C,N; fflush()}'
        [[ $c != 1 ]] && apt-file search -x '^/(usr/)?s?bin/[^/]+$' 2>/dev/null |
            awk -v C="$Y" -v N="$N" -v F=<(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 2>/dev/null) '
                BEGIN {while ((getline l < F) > 0) {split(l,a," "); if (a[1] ~ /^ii/) i[a[2]]}}
                {p=$1; sub(/:$/,"",p); c=$2; sub(".*/","",c)}
                !(p in i) && !s[p,c]++ {printf "%-30s %-35s %snot installed%s\n",c,p,C,N; fflush()}'
        return
    fi

    # ---- args mode: pass 1 = dpkg (installed), pass 2 = apt-file ----
    printf '%-20s %-35s %s\n' INPUT PACKAGE SOURCE
    for lab in installed apt-file; do
        ((${#m[@]})) || break
        if [[ $lab == installed ]]; then
            col=$G; cmd=(dpkg-query -S)
            for n in "${m[@]}"; do cmd+=(/{usr/,}{s,}bin/"$n"); done
        else
            command -v apt-file >/dev/null || break
            col=$Y
            alt=$(printf '%s\n' "${m[@]}" | sed 's/[.+*?^$()[\]{}|\\]/\\&/g' | paste -sd'|')
            cmd=(apt-file search -x "^/(usr/)?s?bin/($alt)$")
        fi
        while IFS= read -r l; do
            pk=${l%%: *}; n=${l##*/}
            [[ ${d[$n]} ]] || { d[$n]=1; printf '%-20s %-35s %s%-10s%s\n' "$n" "$pk" "$col" "$lab" "$N"; }
        done < <("${cmd[@]}" 2>/dev/null)
        t=(); for n in "${m[@]}"; do [[ ${d[$n]} ]] || t+=("$n"); done; m=("${t[@]}")
    done
    for n in "${m[@]}"; do printf '%-20s %s%s%s\n' "$n" "$R" "NOT FOUND" "$N"; done
}


#whatisp
whatisp() {
    local G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' N=$'\e[0m' W=${COLUMNS:-120} c n s pk x t=()
    local -A d
    local q=(dpkg-query -W -f='${db:Status-Abbrev}\t${Package}\t${binary:Summary}\n')

    if (($# == 0)); then   # ---- menu mode ----
        read -rp $'1. Installed only\n2. Not installed only\n3. Both\nChoice [1-3]: ' c
        [[ $c == [123] ]] || { echo "Invalid choice"; return 1; }
        printf '%-35s %s\n' PACKAGE DESCRIPTION
        [[ $c != 2 ]] && "${q[@]}" 2>/dev/null | awk -F'\t' -v C="$G" -v N="$N" -v W="$W" \
            '$1 ~ /^ii/ {printf "%s%-35s%s %s\n", C, $2, N, substr($3, 1, W-37); fflush()}'
        [[ $c != 1 ]] && awk -v C="$Y" -v N="$N" -v W="$W" '
            NR==FNR {split($0, a, "\t"); if (a[1] ~ /^ii/) i[a[2]]; next}
            {p=$1; s=$0; sub(/^[^ ]+ - /, "", s); if (!(p in i)) {printf "%s%-35s%s %s\n", C, p, N, substr(s, 1, W-37); fflush()}}
        ' <("${q[@]}" 2>/dev/null) <(apt-cache search . 2>/dev/null)
        return
    fi

    # ---- args mode ----
    printf '%-30s %-14s %s\n' PACKAGE STATUS DESCRIPTION
    # pass 1: installed (ek hi dpkg-query call)
    while IFS=$'\t' read -r s pk x; do
        [[ $s == ii* ]] && { d[$pk]=1; printf '%-30s %s%-14s%s %s\n' "$pk" "$G" installed "$N" "$x"; }
    done < <("${q[@]}" "$@" 2>/dev/null)
    for n; do [[ ${d[$n]} ]] || t+=("$n"); done
    # pass 2: repository (ek hi apt-cache call)
    if ((${#t[@]})); then
        while IFS=$'\t' read -r pk x; do
            d[$pk]=1; printf '%-30s %s%-14s%s %s\n' "$pk" "$Y" "not installed" "$N" "$x"
        done < <(apt-cache show "${t[@]}" 2>/dev/null | awk '
            /^Package:/ {p=$2}
            /^Description(-[a-z]+)?:/ && !s[p]++ {sub(/^[^:]*: /, ""); print p "\t" $0}')
    fi
    for n; do [[ ${d[$n]} ]] || printf '%-30s %s%s%s\n' "$n" "$R" "NOT FOUND" "$N"; done
}	


