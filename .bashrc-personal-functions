#(helper)	# Common table formatter (s aur S dono isko use karte hain)
#_pkgtable
_pkgtable() {
    local cols color=0
    cols=$(tput cols 2>/dev/null || echo 100)
    [ -t 1 ] && color=1

    PKG_INSTALLED="$(dpkg-query -W -f='${db:Status-Status} ${Package}\n' 2>/dev/null |
        awk '$1=="installed"{sub(/:.*/,"",$2); print $2}')" \
    awk -v cols="$cols" -v color="$color" '
        BEGIN {
            k = split(ENVIRON["PKG_INSTALLED"], arr, "\n")
            for (j = 1; j <= k; j++) { gsub(/[ \r]/, "", arr[j]); if (arr[j] != "") inst[arr[j]] = 1 }
        }
        {
            i = index($0, " - ")
            if (i) { n = substr($0, 1, i-1); d = substr($0, i+3) }
            else   { n = $0; d = "" }
            gsub(/[ \r]/, "", n)
            name[++c] = n; desc[c] = d
            if (length(n) > w) w = length(n)
        }
        END {
            if (!c) { print "Koi package nahi mila" > "/dev/stderr"; exit 1 }
            if (w < 7) w = 7
            dw = cols - w - 5; if (dw < 20) dw = 20
            B = color ? "\033[1m"  : ""
            G = color ? "\033[32m" : ""
            D = color ? "\033[2m"  : ""
            R = color ? "\033[0m"  : ""

            fmt = "%-" w "s"
            printf "%s  %s  %s%s\n", B, sprintf(fmt, "PACKAGE"), "DESCRIPTION", R

            total = w + dw + 5; if (total > cols) total = cols
            line = ""; for (k = 0; k < total; k++) line = line "-"
            print D line R

            ni = 0
            for (k = 1; k <= c; k++) {
                d = desc[k]
                if (length(d) > dw) d = substr(d, 1, dw - 3) "..."
                if (name[k] in inst) { ni++; printf "%s✔%s %s%s%s  %s\n", G, R, G, sprintf(fmt, name[k]), R, d }
                else                 { printf "  %s  %s\n", sprintf(fmt, name[k]), d }
            }
            print D line R
            printf "%s%d packages (%d installed)%s\n", D, c, ni, R
        }'
}


