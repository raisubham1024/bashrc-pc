#pakage
pakage() {
    echo "========================================"
    echo "       PACKAGE LIST DISPLAY TOOL"
    echo "========================================"
    echo "What list do you want to see?"
    echo "1) Installed packages only"
    echo "2) Not installed packages (Available to install)"
    echo "3) Both (Installed and Available packages)"
    echo "----------------------------------------"
    read -p "Choose an option (1-3): " choice

    case $choice in
        1)
            echo ""
            echo "-> Loading INSTALLED packages list..."
            apt list --installed | less
            ;;
        2)
            echo ""
            echo "-> Loading NOT INSTALLED (Available) packages list..."
            apt-cache dumpavail | grep -E '^Package:' | awk '{print $2}' | less
            ;;
        3)
            echo ""
            echo "-> Loading ALL packages (Installed & Available)..."
            apt list | less
            ;;
        *)
            echo "Invalid choice! Please select 1, 2, or 3."
            ;;
    esac
}



