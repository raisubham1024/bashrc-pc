#timee		timee function for caluculate back time [ # (1/2) timee 5h OR 3m   (2/2) timee 18:22 3h OR 8m ]
#week		What was the date <X> weeks age		#week <week_number>
#wdate		current date se given days pehley kya date thee) (e.g wdate 10 [10 days pehley kya date thee]
#days 		days <target_date> OR <day1> <day2>, kitney days,weeks,months & hours ka difference dikhata hai


#timee
timee() {
    local base value num unit

    case $# in
        1)
            base="now"
            value="$1"
            ;;

        2)
            if [[ "$1" =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]]; then
                base="$(date '+%Y-%m-%d') $1"
            else
                echo "Error: time HH:MM format mein do"
                return 1
            fi
            value="$2"
            ;;

        *)
            echo "Usage: timee [Nh|Nm] OR timee HH:MM [Nh|Nm]"
            return 1
            ;;
    esac

    if [[ "$value" =~ ^([0-9]+)(h|m)$ ]]; then
        num="${BASH_REMATCH[1]}"
        unit="${BASH_REMATCH[2]}"

        if [[ "$unit" == "h" ]]; then
            date -d "$base $num hours ago" '+%H:%M'
        else
            date -d "$base $num minutes ago" '+%H:%M'
        fi
    else
        echo "Error: use Nh or Nm (e.g. 5h, 40m)"
        return 1
    fi
}



