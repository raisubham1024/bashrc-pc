#rec	Record a terminal session
#recp	Play the Recorded terminal session 

#rec
rec() {
    read -p "Output file ka naam batao (without .cast): " fname
    asciinema rec --idle-time-limit=2 "${fname}.cast"
}


#recp
recp() {
    asciinema play "$1"
}



