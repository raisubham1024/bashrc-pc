#whichp
whichp() {
    if [ $# -eq 0 ]; then echo "Usage: whichp <name|path> ..."; return 1; fi

    printf '\nCheck in:\n\n  1. Installed only\n  2. Not installed only\n  3. Both\n\n'
    local m a p r l nm rx f pkg k d inst found raw esc
    local -a P
    read -rp "Choice [1-3]: " m
    case "$m" in 1|2|3) ;; *) echo "Invalid choice"; return 1 ;; esac
    if [ "$m" != 1 ] && ! command -v apt-file >/dev/null 2>&1; then
        echo "apt-file missing. Run: sudo apt install apt-file && sudo apt-file update"
        return 1
    fi

    echo
    {
        printf 'PATH\tPACKAGE\tDESCRIPTION\n'
        for a in "$@"; do
            found=0; nm=""; l=""
            case "$a" in
                */*)
                    p=$(realpath -s -- "$a" 2>/dev/null) || p=$a
                    r=$(readlink -f -- "$a" 2>/dev/null)
                    [ -z "$r" ] && r=$p
                    l=$p; [ -L "$p" ] && l="$p -> $r"
                    P=("$p" "$r")
                    esc=$(printf '%s|%s' "${p#/}" "${r#/}" | sed 's/[][\\.*^$+?(){}]/\\&/g')
                    rx="^/?($esc)\$"
                    ;;
                *)
                    nm=$a; P=("$a")
                    esc=$(printf '%s' "$a" | sed 's/[][\\.*^$+?(){}|]/\\&/g')
                    rx="(^|/)$esc\$"
                    ;;
            esac

            for k in i n; do
                [ "$k" = i ] && [ "$m" = 2 ] && continue
                [ "$k" = n ] && [ "$m" = 1 ] && continue

                if [ "$k" = i ]; then
                    raw=$(dpkg -S -- "${P[@]}" 2>/dev/null)
                else
                    raw=$(apt-file -x search "$rx" 2>/dev/null)
                fi

                raw=$(printf '%s\n' "$raw" | awk -v name="$nm" -v lbl="$l" '{
                    i = index($0, ": /"); if (!i) next
                    p = substr($0, i + 2)
                    if (name != "") { c = split(p, b, "/"); if (b[c] != name) next; o = p } else o = lbl
                    n = split(substr($0, 1, i - 1), a, ", ")
                    for (j = 1; j <= n; j++) { sub(/:.*/, "", a[j]); if (!s[o FS a[j]]++) print o "\t" a[j] }
                }')

                while IFS=$'\t' read -r f pkg; do
                    [ -z "$pkg" ] && continue
                    inst=0
                    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' && inst=1
                    d=$(dpkg-query -W -f='${binary:Summary}' "$pkg" 2>/dev/null)
                    [ -z "$d" ] && d=$(apt-cache show "$pkg" 2>/dev/null | sed -n '/^Description/{s/^[^:]*: //p;q}')
                    if [ "$k" = n ]; then
                        [ "$inst" = 1 ] && continue
                        pkg="$pkg [not installed]"
                    fi
                    found=1
                    printf '%s\t%s\t%s\n' "$f" "$pkg" "${d:--}"
                done <<< "$raw"
            done

            [ "$found" = 0 ] && printf '%s\t-\tno match\n' "${l:-$a}"
        done
    } | awk -F'\t' '
        function sep(  i, j, t) { t = "+"; for (i = 1; i <= 3; i++) { for (j = 0; j < w[i] + 2; j++) t = t "-"; t = t "+" } print t }
        { for (i = 1; i <= 3; i++) { c[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) } }
        END {
            sep()
            for (r = 1; r <= NR; r++) {
                t = "|"
                for (i = 1; i <= 3; i++) t = t " " sprintf("%-" w[i] "s", c[r, i]) " |"
                print t; sep()
            }
        }'
    echo
}


