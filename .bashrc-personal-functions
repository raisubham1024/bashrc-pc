#cpp : Copy file with a progress bar
cpp() {
    set -e
    strace -q -ewrite cp -- "${1}" "${2}" 2>&1 |
    awk '{
        count += $NF
        if (count % 10 == 0) {
            percent = count / total_size * 100
            printf "%3d%% [", percent
            for (i=0;i<=percent;i++)
                printf "="
            printf ">"
            for (i=percent;i<100;i++)
                printf " "
            printf "]\r"
        }
    }
    END { print "" }' total_size="$(stat -c '%s' "${1}")" count=0
}






#cpg : Copy and go to the directory
cpg() {
	if [ -d "$2" ]; then
		cp "$1" "$2" && cd "$2"
	else
		cp "$1" "$2"
	fi
}






#mvg : Move and go to the directory
mvg() {
	if [ -d "$2" ]; then
		mv "$1" "$2" && cd "$2"
	else
		mv "$1" "$2"
	fi
}






#big : kisi bhee location k folder and unka size kitna hai janney k liyey. #default hidden file ka nhi show krega, '-h' use mai laan hoga for hidden files/folders
big() {
    dir="."
    [ "$1" = "-h" ] && { hidden=1; shift; }
    [ -n "$1" ] && dir="$1"

    if [ "$hidden" = 1 ]; then
        du -sh "$dir"/{*,.*} 2>/dev/null | sort -hr
    else
        du -sh "$dir"/* 2>/dev/null | sort -hr
    fi
}






