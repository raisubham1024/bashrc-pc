#historyp	: 'pakage' install history
#historypl	: 'pakage + library' install history

#historyp
historyp () {
  local Y=${1:-$(date +%Y)} M=${2:-$([ $# -eq 0 ] && date +%m || echo 1-12)} D=${3:-$([ $# -eq 0 ] && date +%d || echo 1-31)}
  ls -1v /var/log/apt/history.log* 2>/dev/null | tac | xargs -r zcat -f 2>/dev/null | awk -v Y="$Y" -v M="$M" -v D="$D" '
  function rg(s, o) { split(s, t, "-"); o[1] = t[1]; o[2] = (t[2] != "") ? t[2] : t[1] }
  function bar(  i, s, x) { s = "+"; for (i=1; i<=6; i++) { x = sprintf("%" (w[i]+2) "s", ""); gsub(/ /, "-", x); s = s x "+" } print s }
  function row(a,  i, s) { s = "|"; for (i=1; i<=6; i++) s = s sprintf(" %-" w[i] "s |", a[i]); print s }
  BEGIN { rg(Y, y); rg(M, m); rg(D, d) }
  NR == FNR { split($0, t, "\t"); ins[t[1]] = (t[2] == "ii"); next }
  /^Start-Date/ { split($2, a, "-"); yy = a[1]+0; mm = a[2]+0; dd = a[3]+0; dt = sprintf("%02d-%02d-%04d", dd, mm, yy); tm = $3 }
  /^Commandline:/ && yy>=y[1] && yy<=y[2] && mm>=m[1] && mm<=m[2] && dd>=d[1] && dd<=d[2] {
    for (i=1; i<=NF; i++) if ($i ~ /^(install|remove|purge)$/) {
      for (j=i+1; j<=NF; j++) if ($j !~ /^-/) { n = $j; sub(/[=:\/].*/, "", n)
        R[++N] = ++K "\t" dt "\t" tm "\t" toupper(substr($i,1,1)) substr($i,2) "\t" $j "\t" (ins[n] ? "Yes" : "No") }
      break }
  }
  END {
    if (!N) { print "Is date range me koi install/remove record nahi mila."; exit }
    split("No.|Date|Time|Action|Package|Installed Now", h, "|")
    for (i=1; i<=6; i++) w[i] = length(h[i])
    for (k=1; k<=N; k++) { split(R[k], c, "\t"); for (i=1; i<=6; i++) if (length(c[i]) > w[i]) w[i] = length(c[i]) }
    bar(); row(h); bar()
    for (k=1; k<=N; k++) { split(R[k], c, "\t"); row(c) }
    bar()
  }' <(dpkg-query -W -f='${Package}\t${db:Status-Abbrev}\n' 2>/dev/null | sed 's/ *$//' | awk -F'\t' '{print $1 "\t" substr($2,1,2)}') -
}


#historypl
historypl() {
    [[ $1 == -h || $1 == --help ]] && { [[ -f ~/.ih_manual ]] && less ~/.ih_manual || echo "Manual not found: $HOME/.ih_manual"; return; }

    local MODE=install DIFF=0 G="\e[32m" R="\e[31m" N="\e[0m" TODAY=$(date +%F) a t p u x ut d out e L D
    for a; do case $a in -i) MODE=install;; -u) MODE=remove;; -d|--diff) DIFF=1;; esac; done

    # Header
    if ((DIFF)); then L=Duration; elif [[ $MODE == install ]]; then L=install; else L=uninstall; fi
    [[ $L == Duration ]] || L="Date & Time ($L)" && L="Date & Time ($L)"
    D=$(printf '%30s' | tr ' ' -)
    printf "%-25s %-30s %-15s\n" "$L" PACKAGE INSTALLED
    printf "%-25s %-30s %-15s\n" "${D:0:25}" "${D:0:30}" "${D:0:15}"

    # Distro config: log file, package field, install/remove patterns, exists-check command
    if command -v dpkg &>/dev/null; then
        LOG=/var/log/dpkg.log F=4 I=' install ' U=' remove ' C="dpkg-query -W"
    elif command -v pacman &>/dev/null; then
        LOG=/var/log/pacman.log F=5 I='\[ALPM\] installed' U='\[ALPM\] removed' C="pacman -Qq"
    else
        echo "Unsupported distro"; return
    fi
    local M=$I; [[ $MODE == remove && $DIFF -eq 0 ]] && M=$U

    grep -E "$M" "$LOG" | grep "$TODAY" | while read -ra w; do
        t="${w[0]} ${w[1]}"; t=${t//[][]/}; p=${w[F-1]%%:*}

        if ((DIFF)); then
            u=$(grep -E "$U" "$LOG" | grep "$TODAY" | grep " $p[: ]" | head -1)
            if [[ $u ]]; then
                read -ra x <<< "$u"; ut="${x[0]} ${x[1]}"; ut=${ut//[][]/}
                d=$(( $(date -d "$ut" +%s) - $(date -d "$t" +%s) ))
                out=$(date -u -d @"$d" +%H:%M:%S)
            else
                out="Still installed"
            fi
        else
            out=$(date -d "$t" "+%d:%m:%Y %H:%M")
        fi

        $C "$p" &>/dev/null && e="${G}Yes${N}" || e="${R}No${N}"
        printf "%-25s %-30s %-15b\n" "$out" "$p" "$e"
    done
}



