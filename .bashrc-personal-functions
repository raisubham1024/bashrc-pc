#days
days() {
    if [[ $# -lt 1 || $# -gt 2 ]]; then
        echo "Usage:"
        echo "  days DD-MM-YYYY"
        echo "  days DDMMYYYY"
        echo "  days DATE1 DATE2"
        return 1
    fi

    parse_date() {
        local input="$1"
        local d m y

        if [[ $input =~ ^([0-9]{2})-([0-9]{2})-([0-9]{4})$ ]]; then
            d="${BASH_REMATCH[1]}"
            m="${BASH_REMATCH[2]}"
            y="${BASH_REMATCH[3]}"

        elif [[ $input =~ ^([0-9]{2})([0-9]{2})([0-9]{4})$ ]]; then
            d="${BASH_REMATCH[1]}"
            m="${BASH_REMATCH[2]}"
            y="${BASH_REMATCH[3]}"

        else
            return 1
        fi

        date -d "$y-$m-$d" +%s 2>/dev/null
    }

    local start end diff days weeks hours months

    start=$(parse_date "$1") || {
        echo "❌ Invalid date: $1"
        return 1
    }

    if [[ $# -eq 2 ]]; then
        end=$(parse_date "$2") || {
            echo "❌ Invalid date: $2"
            return 1
        }
    else
        end=$(date +%s)
    fi

    if (( start > end )); then
        echo "❌ First date must not be later than the second date."
        return 1
    fi

    diff=$(( end - start ))

    days=$(( diff / 86400 ))
    weeks=$(( days / 7 ))
    hours=$(( diff / 3600 ))
    months=$(awk "BEGIN { printf \"%.2f\", $days/30.44 }")

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if [[ $# -eq 1 ]]; then
        echo "📅 From : $1"
        echo "📅 To   : $(date '+%d-%m-%Y')"
    else
        echo "📅 From : $1"
        echo "📅 To   : $2"
    fi
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    printf "📆 Days   : %'d\n" "$days"
    printf "🗓️ Weeks  : %'d\n" "$weeks"
    printf "📅 Months : %s\n" "$months"
    printf "⏰ Hours  : %'d\n" "$hours"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}


