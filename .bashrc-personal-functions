#spallbin
spallbin() {
    local G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' B=$'\e[1m' D=$'\e[2m' C=$'\e[36m' N=$'\e[0m' W=${COLUMNS:-100}
    local a p x l s c d t f k dl all pk cmds deb ds ld cached nodeb miss off usec M='^/usr/share/man/man[18]/'; local -A m
    local cdir=${XDG_CACHE_HOME:-$HOME/.cache}/spallbin
    (($#)) || { echo "Usage: spallbin <package|command> ..."; return 1; }
    # saari man pages ek hi awk pass mein: "@@name" marker ke baad file, output "name<TAB>description"
    local P='function F(){ if (k!="") {if (!d && (i=index(a," - "))) d=substr(a,i+3); sub(/[ .]+$/,"",d); print k "\t" d}; n=z=0; a=d="" }
        /^@@/ {F(); k=substr($0,3); next}
        /^\.S[Hh]/ {if (n) {n=0; z=1} else if (!z && toupper($0) ~ /NAME/) n=1; next}
        n && /^\.Nd / {sub(/^\.Nd +/,""); d=$0; next}
        n && !/^\.\\"/ {sub(/^\.(B|BR|I|IR|BI|RB|Nm|PP|P|TP|br) */,""); gsub(/\\f[BIRP0-9]|\\\(em|\\&|"/,""); gsub(/\\-/,"-"); a=a " " $0}
        END {F()}'
    for a; do
        pk=("$a")                                   # arg package nahi, command ho to uska package nikalo
        if ! dpkg -L "$a" &>/dev/null; then
            x=$(command -v -- "$a"); l=
            read -r l < <(dpkg-query -S "/usr/bin/$a" "/usr/sbin/$a" "/bin/$a" "/sbin/$a" ${x:+"$x" "$(readlink -f "$x")"} 2>/dev/null)
            if [[ $l ]]; then l=${l%%: /*}; l=${l%%,*}; pk=${l%%:*}
            elif [[ -z $(apt-cache show "$a" 2>/dev/null) ]]; then     # repo package bhi nahi -> repo mein command dhundo
                pk=(); command -v apt-file &>/dev/null && mapfile -t pk < <(apt-file search -x "^/(usr/)?s?bin/${a//[^[:alnum:]_-]/.}$" 2>/dev/null | \awk -F': ' '!s[$1]++ {print $1}')
                ((${#pk[@]})) || { l=${x:+command mila ($x) par kisi package ka nahi}; printf '%s✗ %s: %s%s\n' "$R" "$a" "${l:-na package, na command mila}" "$N"
                                   command -v apt-file &>/dev/null || printf '%s  (command->package lookup ke liye: sudo apt install apt-file && sudo apt-file update)%s\n' "$D" "$N"; echo; continue; }
            fi
            [[ $pk != "$a" ]] && printf '%s→ "%s" ek command hai, package: %s%s\n' "$C" "$a" "${pk[*]}" "$N"
        fi
        for p in "${pk[@]}"; do
            m=(); t=; dl=; deb=; ds=; ld=; cached=; nodeb=; miss=; usec=; s=installed c=$G
            all=$(dpkg -L "$p" 2>/dev/null) && { ds=$(dpkg-query -W -f='${binary:Summary}' "$p" 2>/dev/null); :; } || { s=repo c=$Y dl=1 all=; }
            for f in $(\grep -E "$M" <<<"$all"); do [[ -f $f ]] || { dl=1; break; }; done   # man pages system par missing?
            if [[ $dl ]]; then
                ld=$(apt-cache show "$p" 2>/dev/null | \awk '/^Description/ {f=1; next} f && /^ / {print; next} f {exit}')
                t=$(\mktemp -d)
                # installed hai (par man pages missing) aur cache hai -> seedha cache, internet nahi
                [[ $s == installed && -f $cdir/$p.man ]] && usec=1
                if [[ -z $usec ]]; then
                    # not installed (ya installed + cache nahi): INTERNET pehle
                    if [[ -z $off ]]; then
                        if (cd "$t" && timeout 15 apt-get download "$p" &>/dev/null); then deb=$(\ls "$t"/*.deb 2>/dev/null | head -n1)
                        else off=1; fi          # ek baar fail -> is run mein baaki packages ke liye skip
                    fi
                    # offline fallback: apt cache mein padi .deb
                    [[ $deb ]] || deb=$(\ls -t /var/cache/apt/archives/"$p"_*.deb 2>/dev/null | head -n1)
                fi
                if [[ $deb ]]; then
                    [[ $s == repo ]] && { all=$(dpkg-deb -c "$deb" | \awk '/^-/ {sub(/^[^.]*\./,""); print}'); read -r ds < <(dpkg-deb -f "$deb" Description); }
                    dpkg-deb --fsys-tarfile "$deb" | \tar -x -C "$t" --wildcards './usr/share/man/man[18]/*' 2>/dev/null
                # local cache (installed ke liye pehli pasand, baaki ke liye offline fallback)
                elif [[ -f $cdir/$p.man || -f $cdir/$p.files ]]; then
                    [[ $s == repo && -f $cdir/$p.files ]] && { all=$(<"$cdir/$p.files"); read -r ds <"$cdir/$p.ds"; }
                    [[ -f $cdir/$p.man ]] && while IFS=$'\t' read -r k d; do m[$k]=$d; done <"$cdir/$p.man"
                    cached=1
                else
                    nodeb=1
                fi
            fi
            # offline fallback: apt-file cache se file list
            [[ $all ]] || { s=apt-file; all=$(apt-file list "$p" 2>/dev/null | \sed 's/^[^ ]* //'); }
            [[ $all ]] || { printf '%s✗ %s: not found%s\n' "$R" "$p" "$N"
                            [[ $nodeb ]] && printf '%s  (internet nahi hai aur cache bhi nahi: online ek baar chalao, ya sudo apt-file update)%s\n' "$D" "$N"
                            echo; [[ $t ]] && rm -rf "$t"; continue; }
            [[ $ds ]] || ds=$(apt-cache show "$p" 2>/dev/null | \awk '/^Description(-[a-z]+)?:/ {sub(/^[^:]*: */,""); print; exit}')
            if [[ -z $cached ]]; then
                while IFS=$'\t' read -r k d; do [[ ${m[$k]} ]] || m[$k]=$d; done < <(
                    for f in $(\grep -E "$M" <<<"$all"); do
                        [[ -f $f ]] || f=$t$f; [[ -f $f ]] || continue
                        k=${f##*/}; k=${k%.gz}; printf '@@%s\n' "${k%.*}"; \zcat -f "$f" 2>/dev/null
                    done | \awk "$P")
                if [[ $dl && $deb ]]; then          # cache refresh, agli baar ke liye
                    mkdir -p "$cdir" 2>/dev/null
                    printf '%s\n' "$all" >"$cdir/$p.files"; printf '%s\n' "$ds" >"$cdir/$p.ds"
                    for k in "${!m[@]}"; do printf '%s\t%s\n' "$k" "${m[$k]}"; done >"$cdir/$p.man"
                fi
            fi
            [[ $t ]] && rm -rf "$t"
            mapfile -t cmds < <(\awk -F/ '/\/s?bin\/[^\/]+$/ && !s[$NF]++ {print $NF}' <<<"$all")
            ((${#cmds[@]})) || { printf '%s● %s%s %s(%s)%s : no commands\n\n' "$B" "$p" "$N" "$c" "$s" "$N"; continue; }
            printf '%s● %s%s %s(%s)%s : %d command%s\n' "$B" "$p" "$N" "$c" "$s" "$N" "${#cmds[@]}" "$( ((${#cmds[@]}>1)) && echo s)"
            [[ $ds ]] && printf '  %s[%s]%s\n' "$D" "$ds" "$N"
            for l in "${cmds[@]}"; do
                d=${m[$l]}
                # man page nahi mili -> long description mein "cmd - desc" / "cmd: desc" wali line dhundo
                [[ $d || -z $ld ]] || d=$(\sed -nE "s/^ +[*-]? *${l//[^[:alnum:]_-]/.}( +- +|: +)//p" <<<"$ld" | head -n1)
                [[ $d ]] || { d="(no man page)"; miss=1; }
                printf '  %-22s %s%.*s%s\n' "$l" "$D" $((W-26)) "$d" "$N"
            done
            # note sirf tab jab description missing ho AUR koi offline source na mila ho
            [[ $miss && $nodeb ]] && printf '  %s(internet nahi hai: kuch man pages nahi mili, online chalane par aa jayengi)%s\n' "$D" "$N"
            echo
        done
    done
}


