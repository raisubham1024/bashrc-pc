#service-states	: To view a specific service state (running, failed, inactive, active, dead, or exited) by simply selecting the desired option.


#service-states
service-states() {
    echo "Choose service states:"
    echo "1) running"
    echo "2) failed"
    echo "3) inactive"
    echo "4) active"
    echo "5) dead"
    echo "6) exited"

    read -p "Enter numbers (e.g. 1,3): " input

    local states=""

    IFS=',' read -ra nums <<< "$input"

    for n in "${nums[@]}"; do
        case "$n" in
            1) states+="running," ;;
            2) states+="failed," ;;
            3) states+="inactive," ;;
            4) states+="active," ;;
            5) states+="dead," ;;
            6) states+="exited," ;;
            *) echo "Invalid option: $n"; return 1 ;;
        esac
    done

    states="${states%,}"

    systemctl list-units --type=service --state="$states"
}
