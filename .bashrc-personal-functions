#copy : copyin file data directly to Gpaste clipboard + Advance functionality 1)multiple file se extract ho kr ek single banana 2) ya ek-ek kr k Gpaste mai add
copy() {
    [[ $# -eq 0 ]] && { echo "Usage: copy <file1> [file2] ..."; return 1; }

    if [[ $# -eq 1 ]]; then
        cat "$1" | gpaste-client add
        xclip -selection clipboard < "$1"
        echo "✅ Copied: $1"
        return
    fi

    echo "Multiple files hain — kya karna hai?"
    echo "  1) Sabhi ko ek mein merge karke Gpaste clipboard mein rakho"
    echo "  2) Ek ek karke GPaste Clipboard mein add karo"
    read -rp "Option chuno (1/2): " choice

    case "$choice" in
        1)
            cat "$@" | gpaste-client add
            cat "$@" | xclip -selection clipboard
            echo "✅ Sab merge hokar clipboard mein aa gaya!"
            ;;
        2)
            for file in "$@"; do
                cat "$file" | gpaste-client add
                echo "✅ Added: $file"
            done
            echo "📋 GPaste history mein sab alag alag mil jaayenge!"
            ;;
        *)
            echo "❌ Galat option — 1 ya 2 dono mein se chuno"
            return 1
            ;;
    esac
}






