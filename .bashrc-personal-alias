#`/var/log` ki text log files (rotated wali chhodkar) sab par ek saath tail -f chalata hai, yaani saare logs ki live updates ek terminal me dikhte hain.
alias logs="sudo find /var/log -type f -exec file {} \; | grep 'text' | cut -d' ' -f1 | sed -e's/:$//g' | grep -v '[@-9]$' | xargs tail -f"



